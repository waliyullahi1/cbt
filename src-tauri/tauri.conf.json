{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ExamTips",
  "version": "0.1.4",
  "identifier": "com.virex.cbt",

  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },

  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "ExamTips",
        "url": "splashscreen.html",
        "width": 850,
        "height": 480,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "transparent": true,
        "visible": true,
        "alwaysOnTop": false,
        "shadow": false,
        "skipTaskbar": true,
        "zoomHotkeysEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-pinch"
      },
      {
        "label": "main",
        "title": "CBT - ExamTips",
        "width": 1100,
        "height": 760,
        "minWidth": 320,
        "minHeight": 568,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "zoomHotkeysEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-pinch"
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "resources": [
      "resources/dictionary.db",
      "resources/questions.db",
      "resources/lessons.db"
    ],

    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },

      "wix": {
        "bannerPath": "installer-assets/wix-banner.bmp",
        "dialogImagePath": "installer-assets/wix-dialog.bmp"
      },

      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer-assets/nsis-header.bmp",
        "sidebarImage": "installer-assets/nsis-sidebar.bmp"
      }
    },

    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}